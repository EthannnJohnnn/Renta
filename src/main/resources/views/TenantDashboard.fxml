<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.TenantDashboardController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="navbar">
            <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>
            <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="⌂" />
            <Label style="-fx-text-fill: white;" styleClass="nav-brand" text="Renta" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="welcomeLabel" styleClass="nav-title" text="Welcome, Tenant" />
            <Label style="-fx-text-fill: rgba(255,255,255,0.6);" text="·" />
            <Button onAction="#handleLogout" styleClass="danger-button" text="Logout" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20">
                <padding><Insets bottom="32" left="32" right="32" top="28" /></padding>

                <!-- ═══ HERO BANNER ═══ -->
                <VBox spacing="10" styleClass="hero-banner">
                    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>
                    <Label styleClass="hero-title" text="⌂  Find Your Perfect Home" />
                    <Label styleClass="hero-subtitle" text="Browse available properties and submit your booking today." />
                    <HBox spacing="12">
                        <VBox.margin><Insets top="8" /></VBox.margin>
                        <Button onAction="#handleBrowseProperties" styleClass="card-hero-action" text="Browse All Properties" />
                        <Button onAction="#handleMyBookings" styleClass="card-hero-action" text="☰  My Bookings" />
                    </HBox>
                </VBox>

                <!-- ═══ STAT CARDS ═══ -->
                <HBox spacing="16">
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox alignment="CENTER" styleClass="stat-icon-box-blue">
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2563EB;" text="⌂" />
                            </VBox>
                            <VBox spacing="2" />
                           <Label style="-fx-font-size: 20px;" styleClass="stat-number" text="Browse" />
                        </HBox>
                        <Label styleClass="stat-label" text="Properties">
                            <graphic>
                                <Label styleClass="stat-label" text="Available" />
                            </graphic>
                        </Label>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox alignment="CENTER" styleClass="stat-icon-box-green">
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16A34A;" text="☰" />
                            </VBox>
                            <VBox spacing="2" />
                           <Label style="-fx-font-size: 20px;" styleClass="stat-number" text="Track" />
                        </HBox>
                        <Label styleClass="stat-label" text="Bookings">
                            <graphic>
                                <Label styleClass="stat-label" text="My" />
                            </graphic>
                        </Label>
                    </VBox>
                    <VBox spacing="8" styleClass="stat-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox alignment="CENTER" styleClass="stat-icon-box-amber">
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D97706;" text="★" />
                            </VBox>
                            <VBox spacing="2" />
                           <Label style="-fx-font-size: 20px;" styleClass="stat-number" text="Share" />
                        </HBox>
                        <Label styleClass="stat-label" text="Reviews">
                            <graphic>
                                <Label styleClass="stat-label" text="Leave" />
                            </graphic>
                        </Label>
                    </VBox>
                </HBox>

                <!-- ═══ QUICK SEARCH CARD ═══ -->
                <VBox spacing="14" styleClass="card">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" styleClass="section-label" text="QUICK SEARCH" HBox.hgrow="ALWAYS" />
                        <Label alignment="CENTER_RIGHT" style="-fx-font-size: 14px;" styleClass="subtitle" text="  - Double-click a result to view details" textAlignment="RIGHT" />
                    </HBox>

                    <!-- ═══ UX IMPROVEMENT: SEARCH & FILTER BAR ═══ -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0;" styleClass="card">
                        <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>

                        <!-- Keyword Search -->
                        <TextField fx:id="searchField" promptText="⌕ Search cities, names..." styleClass="input-field" HBox.hgrow="ALWAYS" />

                        <!-- Price Filter -->
                        <ComboBox fx:id="maxPriceFilter" prefWidth="130" promptText="Price" styleClass="combo-field" />

                        <!-- Availability Filter -->
                        <CheckBox fx:id="availableOnlyFilter" style="-fx-font-size: 14px; -fx-text-fill: #334155;" text="Available Rooms Only" />

                        <!-- Actions -->
                        <Button onAction="#handleSearch" styleClass="primary-button" text="Search" />
                        <Button onAction="#handleClearFilters" styleClass="ghost-button" text="Clear" />
                    </HBox>

                    <!-- Results list -->
                    <ListView fx:id="propertyListView" onMouseClicked="#handlePropertyClick" prefHeight="240" styleClass="list-view">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8">
                                <Label styleClass="empty-state-icon" text="⌕" />
                                <Label styleClass="empty-state-title" text="No properties match your search" />
                                <Label styleClass="empty-state-sub" text="Try a different name, address, or adjust your filters." />
                            </VBox>
                        </placeholder>
                    </ListView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
