<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.RegisterController"
           styleClass="form-container"
           stylesheets="@../styles/styles.css">

    <!-- Decorative circles -->
    <Circle radius="120" fill="#BFDBFE" opacity="0.25" translateX="-340" translateY="-200"/>
    <Circle radius="80"  fill="#93C5FD" opacity="0.20" translateX="340"  translateY="220"/>
    <Circle radius="60"  fill="#BFDBFE" opacity="0.18" translateX="280"  translateY="-240"/>
    <Circle radius="100" fill="#DBEAFE" opacity="0.22" translateX="-300" translateY="230"/>

    <ScrollPane fitToWidth="true" styleClass="scroll-pane"
                style="-fx-background-color: transparent; -fx-background: transparent;">
        <VBox alignment="CENTER" style="-fx-padding: 40 0 40 0;">

            <VBox maxWidth="440" spacing="0" alignment="TOP_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 28, 0, 0, 6);
                         -fx-padding: 36 40 32 40;">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Create Account"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
                        <Label text="Join Renta today"
                               style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                    </VBox>
                    <StackPane style="-fx-background-color: #2563EB; -fx-background-radius: 12; -fx-padding: 10;">
                        <Label text="🏠" style="-fx-font-size: 22px;"/>
                    </StackPane>
                </HBox>

                <Region prefHeight="24"/>

                <!-- Username -->
                <Label text="Username" styleClass="label-text">
                    <VBox.margin><Insets bottom="6"/></VBox.margin>
                </Label>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                    <TextField fx:id="usernameField" promptText="Choose a username"
                               styleClass="input-field" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Password -->
                <Label text="Password" styleClass="label-text">
                    <VBox.margin><Insets top="14" bottom="6"/></VBox.margin>
                </Label>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                    <PasswordField fx:id="passwordField" promptText="At least 8 characters"
                                   styleClass="input-field" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Confirm Password -->
                <Label text="Confirm Password" styleClass="label-text">
                    <VBox.margin><Insets top="14" bottom="6"/></VBox.margin>
                </Label>
                <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                                   styleClass="input-field" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Role -->
                <Label text="I am a..." styleClass="label-text">
                    <VBox.margin><Insets top="14" bottom="6"/></VBox.margin>
                </Label>
                <ComboBox fx:id="roleComboBox" promptText="Select your role"
                          styleClass="combo-field" maxWidth="Infinity">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="TENANT"/>
                            <String fx:value="LANDLORD"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Error -->
                <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Label>

                <!-- Submit -->
                <Button text="Create Account" onAction="#handleRegister"
                        styleClass="primary-button" maxWidth="Infinity">
                    <VBox.margin><Insets top="20"/></VBox.margin>
                </Button>

                <!-- Login link -->
                <HBox alignment="CENTER" spacing="4">
                    <VBox.margin><Insets top="16"/></VBox.margin>
                    <Label text="Already have an account?"
                           style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
                    <Hyperlink text="Sign in" onAction="#goToLogin"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #2563EB; -fx-border-color: transparent;"/>
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
