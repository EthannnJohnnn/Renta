<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.LoginController"
           styleClass="form-container"
           stylesheets="@../styles/styles.css">

    <!-- Decorative background circles -->
    <Circle radius="120" fill="#BFDBFE" opacity="0.25"
            translateX="-340" translateY="-200"/>
    <Circle radius="80"  fill="#93C5FD" opacity="0.20"
            translateX="340"  translateY="220"/>
    <Circle radius="60"  fill="#BFDBFE" opacity="0.18"
            translateX="280"  translateY="-240"/>
    <Circle radius="100" fill="#DBEAFE" opacity="0.22"
            translateX="-300" translateY="230"/>

    <!-- Login Card -->
    <VBox alignment="CENTER" maxWidth="420" spacing="0"
          style="-fx-background-color: white; -fx-background-radius: 18;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 28, 0, 0, 6);
                 -fx-padding: 40 40 36 40;">

        <!-- Brand -->
        <VBox alignment="CENTER" spacing="4">
            <Label text="Renta"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1E40AF;"/>
            <Label text="Property Rental Management"
                   style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
        </VBox>

        <Region prefHeight="28"/>

        <Label text="Welcome back!"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"/>
        <Label text="Sign in to your account"
               style="-fx-font-size: 13px; -fx-text-fill: #64748B;">
            <VBox.margin><Insets bottom="24" top="4"/></VBox.margin>
        </Label>

        <!-- Username -->
        <Label text="Username" styleClass="label-text">
            <VBox.margin><Insets bottom="6"/></VBox.margin>
        </Label>
        <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
            <TextField fx:id="usernameField" promptText="Enter your username"
                       styleClass="input-field" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Password -->
        <Label text="Password" styleClass="label-text">
            <VBox.margin><Insets top="16" bottom="6"/></VBox.margin>
        </Label>
        <HBox styleClass="input-wrapper" alignment="CENTER_LEFT">
            <PasswordField fx:id="passwordField" promptText="Enter your password"
                           styleClass="input-field" HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Error -->
        <Label fx:id="errorLabel" text="" styleClass="error-label" wrapText="true">
            <VBox.margin><Insets top="10"/></VBox.margin>
        </Label>

        <!-- Sign In Button -->
        <Button text="Sign In" onAction="#handleLogin" styleClass="primary-button"
                maxWidth="Infinity">
            <VBox.margin><Insets top="20"/></VBox.margin>
        </Button>

        <!-- Register link -->
        <HBox alignment="CENTER" spacing="4">
            <VBox.margin><Insets top="18"/></VBox.margin>
            <Label text="Don't have an account?"
                   style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>
            <Hyperlink text="Register" onAction="#goToRegister"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: #2563EB; -fx-border-color: transparent;"/>
        </HBox>

    </VBox>
</StackPane>
