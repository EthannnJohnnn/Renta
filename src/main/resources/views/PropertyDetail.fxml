<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PropertyDetailController"
            styleClass="page-container"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="🏠" style="-fx-font-size: 20px;"/>
            <Label text="Renta" styleClass="nav-brand"/>
            <Label text="/" style="-fx-text-fill: #475569;"/>
            <Label fx:id="navPropertyName" text="Property Detail" styleClass="nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Listings" onAction="#handleBack"
                    styleClass="secondary-button"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="danger-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="20">
                <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

                <!-- ═══ PROPERTY INFO CARD ═══ -->
                <VBox styleClass="card" spacing="16">

                    <!-- ═══ UX IMPROVEMENT #3 (TENANT VISUALS): PROPERTY IMAGE ═══ -->
                    <!-- Controller: PropertyDetailController.setProperty() loads       -->
                    <!-- property.getImageUrl() into propertyImageView via             -->
                    <!-- new Image(url, true) — show/hide based on null check.         -->
                    <!-- imageContainer hidden by default; controller shows it if url  -->
                    <!-- is not null and not empty.                                    -->
                    <StackPane fx:id="imageContainer"
                               visible="false" managed="false"
                               style="-fx-background-color: #F1F5F9;
                                      -fx-background-radius: 10;"
                               prefHeight="200">
                        <ImageView fx:id="propertyImageView"
                                   fitWidth="720" fitHeight="200"
                                   preserveRatio="true"
                                   smooth="true"/>
                        <!-- Fallback shown if image fails to load -->
                        <Label fx:id="imageErrorLabel" text="📷  Image unavailable"
                               styleClass="subtitle" visible="false"/>
                    </StackPane>

                    <Label fx:id="propertyNameLabel" text="Property Name"
                           styleClass="screen-title"/>

                    <HBox spacing="40">
                        <VBox spacing="4">
                            <Label text="ADDRESS" styleClass="section-label"/>
                            <Label fx:id="propertyAddressLabel" text="—"
                                   styleClass="detail-value"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="DESCRIPTION" styleClass="section-label"/>
                        <Label fx:id="propertyDescriptionLabel" text="—"
                               styleClass="subtitle" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- ═══ ROOMS SECTION ═══ -->
                <VBox spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Available Rooms" styleClass="section-title"
                               HBox.hgrow="ALWAYS"/>
                        <Button fx:id="bookButton" text="📋  Book Selected Room"
                                onAction="#handleBook" styleClass="primary-button"
                                disable="true"/>
                    </HBox>

                    <TableView fx:id="roomsTable" styleClass="table-view" prefHeight="220">
                        <columns>
                            <!-- ═══ UX IMPROVEMENT: CONSISTENT CURRENCY IN HEADER ═══ -->
                            <TableColumn fx:id="roomNumberColumn" text="Room"           prefWidth="100"/>
                            <TableColumn fx:id="capacityColumn"   text="Capacity"       prefWidth="110"/>
                            <TableColumn fx:id="priceColumn"      text="Price / Month (₱)" prefWidth="160"/>
                            <TableColumn fx:id="availableColumn"  text="Status"         prefWidth="120"/>
                        </columns>
                        <!-- ═══ UX IMPROVEMENT: FRIENDLY EMPTY STATE ═══ -->
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10">
                                <Label text="🚪" styleClass="empty-state-icon"/>
                                <Label text="No rooms listed for this property"
                                       styleClass="empty-state-title"/>
                                <Label text="The landlord has not added any rooms yet."
                                       styleClass="empty-state-sub"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <Label fx:id="errorLabel" text="" styleClass="error-label"/>
                </VBox>

                <!-- ═══ REVIEWS SECTION ═══ -->
                <VBox styleClass="card" spacing="14">
                    <Label text="Reviews" styleClass="section-title"/>
                    <ListView fx:id="reviewsListView" styleClass="list-view" prefHeight="160">
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8">
                                <Label text="⭐" styleClass="empty-state-icon"/>
                                <Label text="No reviews yet"
                                       styleClass="empty-state-title"/>
                                <Label text="Be the first to leave a review below."
                                       styleClass="empty-state-sub"/>
                            </VBox>
                        </placeholder>
                    </ListView>
                </VBox>

                <!-- ═══ LEAVE A REVIEW ═══ -->
                <VBox styleClass="card-flat" spacing="16">
                    <Label text="✍  Leave a Review" styleClass="card-title"/>
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <VBox spacing="6">
                            <Label text="Rating" styleClass="label-text"/>
                            <ComboBox fx:id="ratingComboBox" promptText="Select 1–5"
                                      styleClass="combo-field" prefWidth="160"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="Your Comment" styleClass="label-text"/>
                        <TextArea fx:id="commentArea"
                                  promptText="Share your experience with this property..."
                                  styleClass="text-area-field"
                                  prefHeight="80" wrapText="true"/>
                    </VBox>
                    <Label fx:id="reviewErrorLabel" text="" styleClass="error-label"/>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Submit Review" onAction="#handleSubmitReview"
                                styleClass="success-button"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
