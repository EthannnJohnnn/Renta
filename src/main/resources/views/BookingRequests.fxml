<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.BookingRequestsController"
            styleClass="page-container"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="⌂" style="-fx-font-size: 20px; -fx-text-fill: white;"/>
            <Label text="Renta" styleClass="nav-brand"/>
            <Label text="/" style="-fx-text-fill: rgba(255,255,255,0.6);"/>
            <Label text="Booking Requests" styleClass="nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Dashboard" onAction="#handleBackToDashboard"
                    styleClass="secondary-button"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="danger-button"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20">
                <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

                <!-- Header -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Booking Requests" styleClass="screen-title"/>
                        <Label fx:id="requestCountLabel" text="0 pending requests"
                               styleClass="subtitle"/>
                    </VBox>
                </HBox>

                <!-- ACTIONS GUIDE -->
                <HBox styleClass="card-flat" alignment="CENTER_LEFT" spacing="16">
                    <Label text="Actions Guide" styleClass="label-text"/>
                    <Label text="✓ Approve" styleClass="subtitle" style="-fx-text-fill: #16A34A; -fx-font-weight: bold;"/>
                    <Label text="→ Confirms booking" styleClass="subtitle"/>
                    <Label text="  |  " styleClass="subtitle"/>
                    <Label text="✕ Reject" styleClass="subtitle" style="-fx-text-fill: #DC2626; -fx-font-weight: bold;"/>
                    <Label text="→ Declines booking" styleClass="subtitle"/>
                    <Label text="  |  " styleClass="subtitle"/>
                    <Label text="⚐ End Tenancy" styleClass="subtitle" style="-fx-text-fill: #0284C7; -fx-font-weight: bold;"/>
                    <Label text="→ Marks complete" styleClass="subtitle"/>
                </HBox>

                <Label fx:id="messageLabel" text="" styleClass="error-label" wrapText="true"/>

                <!-- CARDS CONTAINER -->
                <VBox fx:id="bookingsContainer" spacing="16">
                    <!-- Filled dynamically by Controller -->
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
