<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MyBookingsController"
            styleClass="page-container"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="Renta" styleClass="nav-brand"/>
            <Label text="/" style="-fx-text-fill: rgba(255,255,255,0.6);"/>
            <Label text="My Bookings" styleClass="nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Dashboard" onAction="#handleBackToDashboard" styleClass="secondary-button"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="danger-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="My Bookings" styleClass="screen-title"/>
                    <Label fx:id="bookingCountLabel" text="0 bookings" styleClass="subtitle"/>
                </VBox>
            </HBox>

            <HBox styleClass="card-flat" alignment="CENTER_LEFT" spacing="12">
                <Label text="Legend:" styleClass="label-text" style="-fx-font-weight: bold;"/>
                <Label text="PENDING" styleClass="badge-pending" style="-fx-font-size: 11px;"/>
                <Label text="APPROVED" styleClass="badge-approved" style="-fx-font-size: 11px;"/>
                <Label text="REJECTED" styleClass="badge-rejected" style="-fx-font-size: 11px;"/>
                <Label text="CANCELLED" styleClass="badge-cancelled" style="-fx-font-size: 11px;"/>
                <Label text="COMPLETED" styleClass="badge-completed" style="-fx-font-size: 11px;"/>
            </HBox>

            <!-- Modern Bookings List (Cards) -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="bookingsListContainer" spacing="16">
                        <padding><Insets top="4" right="4" bottom="20" left="4"/></padding>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>
</BorderPane>
