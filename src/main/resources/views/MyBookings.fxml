<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MyBookingsController"
            styleClass="page-container"
            stylesheets="@../styles/styles.css">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
            <Label text="⌂" style="-fx-font-size: 20px;"/>
            <Label text="Renta" styleClass="nav-brand"/>
            <Label text="/" style="-fx-text-fill: #475569;"/>
            <Label text="My Bookings" styleClass="nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Dashboard" onAction="#handleBackToDashboard"
                    styleClass="secondary-button"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="danger-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20">
            <padding><Insets top="28" right="32" bottom="32" left="32"/></padding>

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="My Bookings" styleClass="screen-title"/>
                    <Label fx:id="bookingCountLabel" text="0 bookings" styleClass="subtitle"/>
                </VBox>
            </HBox>

            <!-- ═══ EXTENDED STATUS GUIDE ═══ -->
            <HBox styleClass="card-flat" alignment="CENTER_LEFT" spacing="14">
                <Label text="Status Guide" styleClass="label-text"/>
                <Label text="⧗ PENDING"   styleClass="badge-pending"/>
                <Label text="→ Awaiting landlord" styleClass="subtitle"/>
                <Label text=" | " styleClass="subtitle"/>
                <Label text="✓ APPROVED"  styleClass="badge-approved"/>
                <Label text="→ Confirmed" styleClass="subtitle"/>
                <Label text=" | " styleClass="subtitle"/>
                <!-- NEW badges -->
                <Label text="✕ REJECTED"  styleClass="badge-rejected"/>
                <Label text="→ Declined" styleClass="subtitle"/>
                <Label text=" | " styleClass="subtitle"/>
                <Label text="⊘ CANCELLED" styleClass="badge-cancelled"/>
                <Label text="→ You cancelled" styleClass="subtitle"/>
                <Label text=" | " styleClass="subtitle"/>
                <Label text="⚐ COMPLETED" styleClass="badge-completed"/>
                <Label text="→ Tenancy ended" styleClass="subtitle"/>
            </HBox>

            <!-- Bookings Table -->
            <TableView fx:id="bookingsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="propertyColumn" text="Property"      prefWidth="185"/>
                    <TableColumn fx:id="roomColumn"     text="Room"          prefWidth="90"/>
                    <TableColumn fx:id="priceColumn"    text="Price / Month" prefWidth="130"/>
                    <TableColumn fx:id="dateColumn"     text="Booking Date"  prefWidth="140"/>
                    <TableColumn fx:id="statusColumn"   text="Status"        prefWidth="130"/>
                    <!-- Expanded width for Cancel Request button -->
                    <TableColumn fx:id="actionsColumn"  text="Actions"       prefWidth="160"/>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="☰" styleClass="empty-state-icon"/>
                        <Label text="No bookings yet"
                               styleClass="empty-state-title"/>
                        <Label text="Browse properties and book a room to get started."
                               styleClass="empty-state-sub"/>
                    </VBox>
                </placeholder>
            </TableView>

        </VBox>
    </center>
</BorderPane>