<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="page-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LandlordDashboardController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="navbar">
            <padding><Insets bottom="14" left="24" right="24" top="14" /></padding>
            <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="⌂" />
            <Label styleClass="nav-brand" text="Renta" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="welcomeLabel" styleClass="nav-title" text="Welcome, Landlord" />
            <Label style="-fx-text-fill: rgba(255,255,255,0.6);" text="·" />
            <Button onAction="#handleLogout" styleClass="danger-button" text="Logout" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20">
                <padding><Insets bottom="32" left="32" right="32" top="28" /></padding>

                <!-- PENDING REQUESTS NOTIFICATION BANNER -->
                <HBox fx:id="pendingBanner" alignment="CENTER_LEFT" managed="false" spacing="16" styleClass="alert-banner" visible="false">
                    <Label style="-fx-font-size: 22px;" text="[!]" />
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="pendingBannerTitle" styleClass="alert-banner-text" text="You have pending booking requests!" />
                        <Label fx:id="pendingBannerSub" styleClass="alert-banner-sub" text="Review and respond to keep your tenants informed." />
                    </VBox>
                    <Button onAction="#handleBookingRequests" styleClass="warning-button" text="Review Now →" />
                </HBox>

                <!-- HERO BANNER -->
                <VBox spacing="10" styleClass="hero-banner">
                    <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>
                    <Label styleClass="hero-title" text="⌂  Manage Your Properties" />
                    <Label styleClass="hero-subtitle" text="Add listings, manage rooms, and handle incoming booking requests." />
                    <HBox spacing="12">
                        <VBox.margin><Insets top="8" /></VBox.margin>
                        <Button onAction="#handleManageListings" styleClass="card-hero-action" text="Manage Listings" />
                        <Button onAction="#handleBookingRequests" styleClass="card-hero-action" text="✉ Booking Requests" />
                        <Button onAction="#handleAddProperty" styleClass="card-hero-action" text="+ Add Property" />
                    </HBox>
                </VBox>

                <!-- STAT CARDS -->
                <HBox spacing="16">
                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox styleClass="stat-icon-box-blue" alignment="CENTER" minWidth="48">
                                <Label text="⌂" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="My Properties" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                        <Label text="Manage" styleClass="stat-number" style="-fx-font-size: 20px;"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox styleClass="stat-icon-box-green" alignment="CENTER" minWidth="48">
                                <Label text="⊞" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Room Management" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                        <Label text="Rooms" styleClass="stat-number" style="-fx-font-size: 20px;"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox styleClass="stat-icon-box-amber" alignment="CENTER" minWidth="48">
                                <Label text="✉" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                            </VBox>
                            <VBox spacing="2">
                                <Label text="Pending Requests" styleClass="stat-label"/>
                            </VBox>
                        </HBox>
                        <!-- Controller sets this via pendingCountStat -->
                        <Label fx:id="pendingCountStat" text="0" styleClass="stat-number" style="-fx-font-size: 32px;"/>
                    </VBox>
                </HBox>

                <!-- MY LISTINGS PREVIEW (Cards instead of ListView) -->
                <VBox spacing="18">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="screen-title" text="My Listings Preview" HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleManageListings" styleClass="secondary-button" text="View All →" />
                    </HBox>
                    <VBox fx:id="listingsContainer" spacing="16">
                        <!-- Filled dynamically by Controller -->
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
